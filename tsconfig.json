{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@config": [
        "./src/config.example.ts"
      ],
      "@data": [
        "./src/data/real.tsx"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}