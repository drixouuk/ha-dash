# Variables du dashboard. Copier ce fichier en `.env.local` pour le développement
# local (`npm run dev`) ; les variables HA_* se passent au script de déploiement.
#
# ATTENTION : tout ce qui commence par VITE_ est gravé dans le bundle par Vite.
# `scripts/deploy.sh` force VITE_HA_URL et VITE_HA_TOKEN à vide pour le build
# publié, et refuse de publier si un jeton apparaît dans dist/.

# ------------------------------------------------------------------ build / dev

# URL de Home Assistant. Laisser VIDE quand le dashboard est servi par Home
# Assistant lui-même (/local/dashboard/) : il utilise alors l'origine courante et
# hérite de la session déjà ouverte.
VITE_HA_URL=

# Jeton d'accès longue durée, réservé au développement à distance.
# JAMAIS de jeton dans un build publié dans /config/www : ce dossier est servi
# sans authentification à quiconque atteint Home Assistant.
VITE_HA_TOKEN=

# ------------------------------------------------------------------ déploiement
# Lues par scripts/deploy.sh, à passer en variable d'environnement (pas de .env) :
#   HA_HOST=192.0.2.10 npm run deploy

# Hôte ou IP de la machine Home Assistant — OBLIGATOIRE, aucune valeur par défaut.
HA_HOST=

# Utilisateur SSH (défaut : root).
HA_USER=root

# Clé SSH privée (défaut : ~/.ssh/HA_VM).
HA_KEY=

# Port HTTP de Home Assistant (défaut : 8123).
HA_PORT=8123

# Dossier créé dans /config/www, servi sur /local/<dossier>/ (défaut : dashboard).
HA_DASH_FOLDER=dashboard

# URL publique, uniquement pour l'affichage final du script (facultatif).
HA_PUBLIC_URL=
